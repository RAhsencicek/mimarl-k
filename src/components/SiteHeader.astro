<header class="site-header">
  <a class="wordmark" href="/" aria-label="ZCY Mimarlık ana sayfa">
    <img src="/images/zcy-mimarlik-logo.svg" alt="ZCY Mimarlık" width="180" height="64" />
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
    <span class="menu-toggle__label">Menü</span>
    <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
  </button>
  <nav class="site-nav" id="site-navigation" aria-label="Ana gezinme" data-open="false">
    <a href="/projeler/">Projeler</a>
    <a href="/hizmetler/">Hizmetler</a>
    <a href="/studyo/">Stüdyo</a>
    <a href="/iletisim/">İletişim</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = document.querySelector<HTMLElement>('#site-navigation');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Menüyü aç' : 'Menüyü kapat');
    navigation?.setAttribute('data-open', String(!isOpen));
    document.body.classList.toggle('menu-is-open', !isOpen);
  });

  navigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Menüyü aç');
      navigation.setAttribute('data-open', 'false');
      document.body.classList.remove('menu-is-open');
    });
  });
</script>
