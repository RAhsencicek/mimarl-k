---
import SiteHeader from '../components/SiteHeader.astro';
import SplashScreen from '../components/SplashScreen.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  immersive?: boolean;
}

const { title, description = 'ZCY Mimarlık — yaşam alanları ve yapılı çevre için mimari tasarım.', immersive = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9e7e1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} — ZCY Mimarlık</title>
  </head>
  <body>
    <SplashScreen />
    <a class="skip-link" href="#main">İçeriğe geç</a>
    {!immersive && <SiteHeader />}
    <main id="main"><slot /></main>
  </body>
</html>
